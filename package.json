{
  "name": "restassured",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "dev:seed": "tsx scripts/dev-seed.ts",
    "build": "vite build && pnpm build:cli",
    "build:cli": "esbuild scripts/cli.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=build/cli.js --log-level=warning",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "tsx scripts/dev-db.ts up",
    "db:down": "tsx scripts/dev-db.ts down",
    "db:reset": "tsx scripts/dev-db.ts reset",
    "db:bootstrap": "tsx scripts/cli.ts bootstrap",
    "db:migrate": "tsx scripts/cli.ts migrate",
    "db:codegen": "kysely-codegen --dialect postgres --url 'env(RA_DATABASE_OWNER_URL)' --out-file src/lib/server/db/schema.d.ts --exclude-pattern schema_migrations --log-level error && prettier --write --ignore-path '' src/lib/server/db/schema.d.ts",
    "i18n:lint": "tsx scripts/i18n-lint.ts",
    "licenses:check": "node scripts/check-licenses.mjs",
    "docs:dev": "pnpm --filter restassured-docs dev",
    "docs:build": "pnpm --filter restassured-docs build",
    "docs:preview": "pnpm --filter restassured-docs preview",
    "cli": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
