# Copy to .env for local development. Values match `pnpm db:up` (scripts/dev-db.ts).

# Application role: no BYPASSRLS, subject to row-level security (ADR-0001).
RA_DATABASE_URL=postgres://ra_app:ra_app_dev@localhost:54320/restassured
# Owner role: runs migrations (ADR-0008). Only needed when migrating.
RA_DATABASE_OWNER_URL=postgres://ra_owner:ra_owner_dev@localhost:54320/restassured
RA_MIGRATE_ON_START=true

# nl | en
RA_DEFAULT_LOCALE=nl
# AGPL §13: link to the source of the code you run (ADR-0009).
# RA_SOURCE_URL=https://github.com/<you>/<your-fork>

# Superuser connection, used only by `pnpm db:bootstrap` and to create the test database.
RA_BOOTSTRAP_ADMIN_URL=postgres://postgres:postgres@localhost:54320/postgres

# Public URL of this installation (used by adapter-node and for links printed by the CLI).
ORIGIN=http://localhost:5173
